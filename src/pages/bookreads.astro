---
import BaseLayout from '../layouts/BaseLayout.astro';
import { reading } from '../data/reading';
---

<BaseLayout
  title="Bookreads"
  path="/bookreads.html"
  description="Books I'm reading and have read."
>
  <article class="page">
    <div class="page__inner-wrap">
      <header>
        <h1 class="page__title">Bookreads</h1>
      </header>
      <section class="page__content">
        <h2>Currently reading</h2>
        {
          reading.length > 0 ? (
            <ul>
              {reading.map((item) => (
                <li>
                  <strong>{item.title}</strong> — {item.author}
                  {item.status === 'reading' && <span class="btn btn--primary">reading</span>}
                  {item.status === 'finished' && <span class="btn">finished</span>}
                </li>
              ))}
            </ul>
          ) : (
            <p>List coming soon.</p>
          )
        }
        <p>
          Live updates: <a href="https://twitter.com/akshay326_">Twitter</a> ·{' '}
          <a href="https://github.com/akshay326">GitHub</a> · Readwise
        </p>
        <script
          is:inline
          src="https://www.goodreads.com/review/grid_widget/96697553.Books%20I've%20Read?cover_size=medium&hide_link=&hide_title=&num_books=30&order=a&shelf=read&sort=date_added&widget_id=1627567641"
        ></script>
        <style is:global>
          #goodreads {
            padding: 15vh 0;
          }
          @media only screen and (max-width: 600px) {
            #goodreads {
              padding: 5vh 6vw 10vh 6vw;
            }
          }
          .gr_grid_book_container {
            float: left;
            width: 98px;
            height: 160px;
            padding: 0px 0px;
            overflow: hidden;
          }
          #gr_updates_widget {
            border-radius: 1rem;
            -webkit-box-shadow: 0px 0px 4px 1px #595959, inset 0px 0px 0px 1px #7d730b;
            -moz-box-shadow: 0px 0px 4px 1px #595959, inset 0px 0px 0px 1px #7d730b;
            box-shadow: 0px 0px 4px 1px #595959, inset 0px 0px 0px 1px #7d730b;
            padding: 10px 0 0 10px;
            height: 650px;
            width: fit-content;
          }
          #gr_updates_widget p {
            padding: 0px;
            margin: 0;
            font-size: 14px;
          }
        </style>
        <div id="goodreads" class="container">
          <div id="gr_grid_widget_1627567641"></div>
        </div>
        <div class="row justify-content-md-center m-2">
          <div class="col-xs-12 col-md-3">
            <h2>Book Update</h2>
            <div id="gr_updates_widget">
              <iframe
                id="the_iframe"
                title="Update"
                src="https://www.goodreads.com/widgets/user_update_widget?num_updates=5&user=96697553"
                style="border: 0"
                width="100%"
                height="100%"
              ></iframe>
            </div>
          </div>
        </div>
      </section>
    </div>
  </article>
</BaseLayout>
